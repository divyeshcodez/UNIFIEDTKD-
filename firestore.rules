rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'officialunifiedtkd@gmail.com' ||
        request.auth.token.email == 'bakredivyesh@gmail.com' ||
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.matches('(?i)^officialunifiedtkd@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^bakredivyesh@gmail\\.com$')
        )) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    match /applications/{applicationId} {
      // Only authenticated admin can view, update (approve/reject), or delete applications
      allow read, update, delete: if isAdmin();

      // Public can submit validated applications with Pending status
      allow create: if request.resource.data.status == 'Pending'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 25
        && (
          (request.resource.data.keys().hasAny(['branch']) && request.resource.data.branch is string && request.resource.data.branch.size() > 0) ||
          (request.resource.data.keys().hasAny(['branchBatch']) && request.resource.data.branchBatch is string && request.resource.data.branchBatch.size() > 0)
        )
        && request.resource.data.createdAt is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
